


// exemplo simples de dfs recursivo

public void allPathsSourceTarget(int[][] graph) {

        int source = 0;
        int target = graph.length - 1;

        Set<Integer> visited = new HashSet<>();

        dfs(graph, source, target, visited);

    }

    private void dfs(int[][] graph, int node, int target, Set<Integer> visited) {

        visited.add(node);
        int[] neighbors = graph[node];

        for (int i = 0; i < neighbors.length; i++) {
            if (!visited.contains(neighbors[i])) {
                dfs(graph, neighbors[i], target, visited);
            }
        }
    }